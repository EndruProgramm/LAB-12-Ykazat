#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>
#include <stdlib.h>
#include <math.h>

int main() {
    setlocale(LC_ALL, "Russian");
    char c = 'A', * pc = &c;
    int i = 5, * pi = &i;
    double d = 2.1, * pd = &d;
    printf("Размер указателя на char:   %d байт\n", sizeof(pc));
    printf("Размер указателя на int:    %d байт\n", sizeof(pi));
    printf("Размер указателя на double: %d байт\n", sizeof(pd));

    return 0;
}
